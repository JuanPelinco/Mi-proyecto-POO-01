<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.cine.control.LoginController"
            stylesheets="@../css/darkpro.css"
            prefWidth="420" prefHeight="520">

    <children>
        <VBox spacing="18" alignment="CENTER"
              prefWidth="360" prefHeight="440"
              layoutX="30" layoutY="40"
              style="-fx-background-color: #161a21; -fx-background-radius: 12; -fx-padding: 35;">

            <Label text="CINE PELINCO"
                   style="-fx-font-size: 26px; -fx-text-fill: #1e90ff; -fx-font-weight: bold;" />

            <Label text="Iniciar Sesión"
                   style="-fx-font-size: 16px; -fx-text-fill: #e0e6f0;" />

            <VBox spacing="6">
                <Label text="Usuario" />
                <TextField fx:id="txtUser" promptText="Ingrese su usuario"
                           style="-fx-prompt-text-fill: #767c89;" />
            </VBox>

            <VBox spacing="6">
                <Label text="Contraseña" />
                <PasswordField fx:id="txtPass" promptText="Ingrese su contraseña"
                               style="-fx-prompt-text-fill: #767c89;" />
            </VBox>

            <Button text="Ingresar" onAction="#loginAction"
                    styleClass="button" prefWidth="180" />


            <VBox spacing="10" alignment="CENTER">
                <Button text="Registrar usuario"
                        onAction="#openRegisterWindow"
                        style="-fx-background-color: #42a5ff; -fx-text-fill: white; -fx-background-radius: 6px;"
                        prefWidth="180"/>

                <Button text="Eliminar usuario"
                        onAction="#openDeleteWindow"
                        style="-fx-background-color: #ff4c4c; -fx-text-fill: white; -fx-background-radius: 6px;"
                        prefWidth="180"/>
            </VBox>

            <Separator prefWidth="260" />

            <Label text="© 2025 Cine Pelinco — Sistema de Ventas"
                   style="-fx-text-fill: #9aa1ac; -fx-font-size: 11px;" />

        </VBox>
    </children>
</AnchorPane>
