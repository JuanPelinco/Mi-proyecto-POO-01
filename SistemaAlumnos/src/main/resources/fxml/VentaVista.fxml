<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sistemaalumnos.control.VentaFxControl">

    <top>
        <Label text="💺 Gestión de Venta de Boletos"
               style="-fx-font-size:20; -fx-padding:10; -fx-font-weight:bold;"/>
    </top>

    <center>
        <TableView fx:id="tablaVentas">
            <columns>
                <TableColumn text="ID" fx:id="colId" prefWidth="50"/>
                <TableColumn text="Cliente" fx:id="colCliente" prefWidth="150"/>
                <TableColumn text="Destino" fx:id="colDestino" prefWidth="150"/>
                <TableColumn text="Precio" fx:id="colPrecio" prefWidth="100"/>
                <TableColumn text="Fecha" fx:id="colFecha" prefWidth="120"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10" alignment="CENTER" style="-fx-padding:10;">
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="txtCliente" promptText="Cliente"/>
                <ComboBox fx:id="cmbDestino" promptText="Destino"/>
                <ComboBox fx:id="cmbHorario" promptText="Horario"/>
                <TextField fx:id="txtPrecio" promptText="Precio"/>
                <TextField fx:id="txtFecha" promptText="Fecha (YYYY-MM-DD)"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER">
                <Button text="Agregar" onAction="#agregarVenta"/>
                <Button text="Actualizar" onAction="#actualizarVenta"/>
                <Button text="Eliminar" onAction="#eliminarVenta"/>
                <Button text="Volver" onAction="#volverMenu"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
