<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../css/estilo.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sistemaalumnos.control.AlumnoFxControl">


    <top>
        <Label style="-fx-font-size:20; -fx-padding:10; -fx-font-weight:bold;" text="🎓 Sistema de Gestión de Venta Voleto" />
    </top>

    <center>
        <TableView fx:id="tablaAlumnos">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="149.0" text="Destino Salida" />
                <TableColumn fx:id="colApellido" prefWidth="115.0" text="Destino Llegada" />
                <TableColumn fx:id="colEdad" prefWidth="143.0" text="Hora Salida" />
                <TableColumn fx:id="colCorreo" prefWidth="116.0" text="Hora Llegada" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding:10;">
            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="txtNombre" promptText="Destino/Salida" />
                <TextField fx:id="txtApellido" promptText="Destino/Llegada" />
                <TextField fx:id="txtEdad" promptText="Hora/Salida" />
                <TextField fx:id="txtCorreo" promptText="Hora/Llegada" />
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#agregarAlumno" text="Agregar" />
                <Button onAction="#actualizarAlumno" text="Actualizar" />
                <Button onAction="#eliminarAlumno" text="Eliminar" />
                <Button onAction="#listarAlumnos" text="Refrescar" />
                <Button onAction="#irAVentas" text="Ir a Ventas" />

            </HBox>
        </VBox>
    </bottom>
</BorderPane>
